# Pi custom-LLM server
PORT=8787
PUBLIC_BASE_URL=https://your-service.up.railway.app
PI_SERVER_API_KEY=replace-with-a-long-random-string

# Private web call-room access
DASHBOARD_KEY=replace-with-a-different-long-random-string
VANCE_CALLER_NUMBER=

# Optional Vapi event-webhook authentication.
WEBHOOK_SECRET=replace-with-a-long-random-string
VAPI_WEBHOOK_CREDENTIAL_ID=

# Vapi (server-side private key only)
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
# Created once by `npm run setup:credential`. Assistants themselves are built
# per call from a mission file, so there is no assistant id to keep in sync.
VAPI_CUSTOM_LLM_CREDENTIAL_ID=
VAPI_VOICE_PROVIDER=vapi
VAPI_VOICE_ID=Elliot
# Long enough to survive a hold queue. Per-call duration comes from the
# mission's maxMinutes.
VAPI_SILENCE_TIMEOUT_SECONDS=1800

# Pi's underlying model
OPENAI_API_KEY=
PI_MODEL=gpt-5.5
# Reasoning tokens sit directly in the gap the other person hears, and most
# conversational turns need none.
PI_THINKING_LEVEL=low
# OpenAI calls this Priority processing; it is the fast pay-as-you-go tier.
PI_SERVICE_TIER=priority

# Prefilled in the dashboard and used when the CLI is given no number.
DEFAULT_DESTINATION=
# Optional fallback context when no contexts/<mission>.txt file exists.
VANCE_CONTEXT_TEXT=
