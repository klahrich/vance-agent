# Pi custom-LLM server
PORT=8787
PUBLIC_BASE_URL=https://your-public-webhook.example.com
PI_SERVER_API_KEY=replace-with-a-long-random-string

# Private web call-room access
DASHBOARD_KEY=replace-with-a-different-long-random-string
VANCE_CALLER_NUMBER=

# Optional Vapi event-webhook authentication.
WEBHOOK_SECRET=replace-with-a-long-random-string
VAPI_WEBHOOK_CREDENTIAL_ID=

# Vapi (server-side private key only)
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_CUSTOM_LLM_CREDENTIAL_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_VOICE_PROVIDER=vapi
VAPI_VOICE_ID=Elliot
VAPI_SILENCE_TIMEOUT_SECONDS=1800
VAPI_MAX_DURATION_SECONDS=43200

# Pi's underlying model
OPENAI_API_KEY=
PI_MODEL=gpt-5.6-terra
PI_THINKING_LEVEL=medium
# OpenAI calls this Priority processing; it is the fast pay-as-you-go tier.
PI_SERVICE_TIER=priority

# Destination is deliberately not committed to source control.
BELL_PHONE_NUMBER=
